# API Configuration
NODE_ENV=development
API_PORT=3000
API_HOST=localhost
API_BASE_URL=http://localhost:3000

# Database Configuration
DB_TYPE=mongodb
DB_HOST=localhost
DB_PORT=27017
DB_NAME=farmer_learning_platform
DB_USER=farmer_admin
DB_PASSWORD=your_secure_password

# MongoDB Connection String (Alternative to individual fields)
MONGODB_URI=mongodb://localhost:27017/farmer_learning_platform

# AI Provider Selection (openai, anthropic, gemini, kimi2, grok)
AI_PROVIDER=anthropic

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# Kimi2 (Moonshot AI) Configuration
KIMI2_API_KEY=your-kimi2-api-key-here
KIMI2_MODEL=moonshot-v1-8k
KIMI2_BASE_URL=https://api.moonshot.cn/v1

# Grok (xAI) Configuration
GROK_API_KEY=your-grok-api-key-here
GROK_MODEL=grok-1
GROK_BASE_URL=https://api.x.ai/v1

# N8N Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=your_n8n_api_key

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-change-this
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_TTL=3600
ENABLE_CACHE=true

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# External APIs (Optional)
WEATHER_API_KEY=your_weather_api_key
SOIL_DATA_API_KEY=your_soil_data_api_key
SATELLITE_API_KEY=your_satellite_api_key

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Feature Flags
ENABLE_CROP_RECOMMENDATION=true
ENABLE_FERTILIZER_ADVISOR=true
ENABLE_WATER_MANAGEMENT=true
ENABLE_FARMING_TECHNIQUES=true
