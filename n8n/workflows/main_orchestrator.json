            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Crop Advisor Agent": {
      "main": [
        [
          {
            "node": "Log Query to Database",
            "type": "main",
            "index": 0
          },
          {
            "node": "Aggregate Responses",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Fertilizer Advisor Agent": {
      "main": [
        [
          {
            "node": "Aggregate Responses",
            "type": "main",
            "index": 0
          }
        ]
      ]
