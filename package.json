{
  "name": "ai-farmer-learning-platform",
  "version": "1.0.0",
  "description": "AI-powered learning platform for farmers using n8n and specialized agents",
  "main": "api/server.js",
  "type": "module",
  "scripts": {
    "start": "node api/server.js",
    "dev": "nodemon api/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "migrate": "node database/migrations/run-migrations.js",
    "seed": "node database/migrations/seed-data.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "keywords": [
    "agriculture",
    "ai",
    "n8n",
    "farming",
    "machine-learning",
    "agents"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "mongodb": "^6.3.0",
    "mongoose": "^8.0.3",
    "axios": "^1.6.2",
    "openai": "^4.24.1",
    "@anthropic-ai/sdk": "^0.10.0",
    "joi": "^17.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "winston": "^3.11.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "langchain": "^0.1.0",
    "@langchain/openai": "^0.0.10",
    "@langchain/anthropic": "^0.0.5",
    "n8n": "^1.19.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "@types/jest": "^29.5.11"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
